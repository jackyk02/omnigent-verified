{
  "name": "codify-desktop-electron",
  "productName": "Codify",
  "version": "0.6.0",
  "description": "Codify desktop shell (Electron edition) — a thin native wrapper around the server-served web UI.",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://codify.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/codify-ai/codify.git"
  },
  "author": {
    "name": "Databricks, Inc.",
    "email": "support@codify.ai"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac:release": "electron-builder --mac -c.mac.notarize=true",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:overlay": "pnpm --filter web run build:overlay",
    "predev": "pnpm run build:overlay",
    "prestart": "pnpm run build:overlay",
    "prebuild": "pnpm run build:overlay",
    "prebuild:mac": "pnpm run build:overlay",
    "prebuild:mac:release": "pnpm run build:overlay",
    "prebuild:linux": "pnpm run build:overlay",
    "prebuild:win": "pnpm run build:overlay"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ai.codify.desktop",
    "productName": "Codify",
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Codify session link",
        "schemes": [
          "codify"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://codify.ai/_desktop/updates/"
      }
    ],
    "afterPack": "build/afterPack.js",
    "files": [
      "src/**/*",
      "setup/**/*",
      "find/**/*",
      "icons/**/*",
      "overlay/**/*"
    ],
    "extraResources": [
      {
        "from": "../platform-assets",
        "to": "platform-assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon.icns",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "identity": "Databricks, Inc. (8RMX4WU6F8)",
      "hardenedRuntime": true,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Codify uses the microphone for voice dictation in the message composer.",
        "CFBundleIconName": "AppIcon"
      },
      "gatekeeperAssess": false,
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://codify.ai/_desktop/updates/"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "background": "dmg/background.tiff",
      "window": {
        "width": 640,
        "height": 465
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 170,
          "y": 100
        },
        {
          "x": 470,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Development",
      "maintainer": "Databricks, Inc. <support@codify.ai>",
      "target": [
        "AppImage",
        "deb"
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://codify.ai/_desktop/updates/"
        }
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis"
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://codify.ai/_desktop/updates/"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.3.0"
  }
}
